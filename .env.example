# ── Backend API ──
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Data Mode ──
# Options: demo, archive
DATA_MODE=demo

# ── Logging ──
LOG_LEVEL=INFO

# ── ML ──
ML_MODEL_DIR=ml_models
