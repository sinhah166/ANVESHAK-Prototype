# Copy this file to .env and adjust values as needed.
# DO NOT commit .env to version control.

# ── PostgreSQL ──
POSTGRES_USER=anveshak
POSTGRES_PASSWORD=anveshak_dev_2024
POSTGRES_DB=anveshak
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ── Redis ──
